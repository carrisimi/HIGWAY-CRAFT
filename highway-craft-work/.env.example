# Server-side secret: required for AI chat, search grounding, audio transcription and live voice.
# Add this in Vercel Project Settings > Environment Variables for Production and Preview.
GEMINI_API_KEY=

# Browser API key: optional; required for Google Maps and map-grounded features.
# Restrict this key by website referrer and enabled Google Maps APIs.
VITE_GOOGLE_MAPS_API_KEY=

# Optional legacy Cloud SQL settings. The learner app now stores cloud progress
# directly in the signed-in user's Firestore profile; SQL is not required for it.
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
